#!/bin/bash

source $DIR_WAN/wan.conf

######################################################################
###  Estat
######################################################################
fnc_enrutar_estat() {
	#echo fnc_enrutar_estat
	
	# Comprovar IP Forward
	local FORWARD=$(sysctl -n net.ipv4.ip_forward)
	[ "$(sysctl -n net.ipv4.ip_forward)" = "1" ] && FORWARD=1

	# Comprovar regla NAT
	local NAT=0
		iptables -t nat -C POSTROUTING -o "$WAN_INT" -j MASQUERADE 2>/dev/null && NAT=1

	# Comprovar estat
	if [ "$FORWARD" -eq 1 ] && [ "$NAT" -eq 1 ]; then
    		echo "$ACTIVAT"
    		return 0
	else
    		echo "$DESACTIVAT"
    		return 1
	fi
}
